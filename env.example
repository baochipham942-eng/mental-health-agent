# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# LLM Provider配置
# 默认仍然使用 deepseek。若要切换 provider，可设置 DEFAULT_LLM_PROVIDER=glm / openrouter
# DEFAULT_LLM_PROVIDER=deepseek
# SUPPORT_LLM_PROVIDER=deepseek
# ASSESSMENT_LLM_PROVIDER=deepseek
# STATE_CLASSIFIER_LLM_PROVIDER=deepseek
# SAFETY_LLM_PROVIDER=deepseek
# MEMORY_LLM_PROVIDER=deepseek

# GLM API配置（可选，做 provider/A-B 测试时使用）
GLM_API_KEY=your_glm_api_key_here
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_CHAT_MODEL=glm-5

# OpenRouter API配置（可选）
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
OPENROUTER_FAST_MODEL=openai/gpt-4.1-mini
FAST_AGENT_PROVIDER=openrouter
# OPENROUTER_HTTP_REFERER=https://your-app.example.com
# OPENROUTER_APP_TITLE=mental-health-agent

# OpenAI Responses API配置（可选，做 smoke 测试时使用）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5.4

# 管理员白名单（逗号分隔）
ADMIN_PHONES=phone1,phone2
ADMIN_USERNAMES=username1,username2

# 应用配置
NEXT_PUBLIC_APP_NAME=心理疗愈助手

# 测试配置
# Assessment Conclusion 性能门禁阈值（P50 total，单位：毫秒）
# 默认值：9500ms（可通过环境变量调整）
# SMOKE_CONCLUSION_P50_MS=9500

# Skill 系统配置
# SKILL_MODE: 控制 Skill 系统的使用模式
# - off: 完全走旧逻辑（默认，便于回滚）
# - cards_only: actionCards 来自 skills，文本仍由 LLM 生成
# - steps_and_cards: next steps 文本 + actionCards 都来自 skills（推荐）
# SKILL_MODE=off

# LANGFUSE API配置
# 设置为 false 禁用 Langfuse 追踪（如果没有配置正确的密钥，推荐设置为 false）
LANGFUSE_ENABLED="false"
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
