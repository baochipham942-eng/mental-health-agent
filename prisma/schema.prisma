generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id              String             @id @default(cuid())
  username        String             @unique
  passwordHash    String
  nickname        String?
  createdAt       DateTime           @default(now())
  avatar          String?
  phone           String?            @unique
  quickLoginToken String?
  lastLoginAt     DateTime?          // 上次登录时间
  reports         AssessmentReport[]
  conversations   Conversation[]
  exerciseLogs    ExerciseLog[]
  exerciseStates  ExerciseState[]
  evaluations     ConversationEvaluation[]
  labSessions     LabSession[]       // 实验室会话
  crisisEscalations CrisisEscalation[]
  questionnaireScores QuestionnaireScore[]
  progressMetrics  ProgressMetric[]
  preferredTherapist String?           // 'xiaowarm' | 'mingyuan' | 'qinghe'
  memoryCandidates MemoryCandidate[]
  profileMemories  ProfileMemory[]
  sessionSummariesV2 SessionSummaryV2[]
  // Session Metadata（借鉴 ChatGPT，追踪使用行为模式）
  sessionCount     Int      @default(0)   // 累计会话数
  lastSessionAt    DateTime?              // 上次会话时间
  avgSessionHour   Float?                 // 平均使用时段（0-23）
  activeStreak     Int      @default(0)   // 连续活跃天数
  lastActiveDateStr String?               // 上次活跃日期 "YYYY-MM-DD"，用于计算 streak
}

model InvitationCode {
  id        String   @id @default(cuid())
  code      String   @unique
  type      String   @default("REGISTRATION")
  maxUsages Int      @default(1)
  usedCount Int      @default(0)
  expiresAt DateTime
  channel   String?
  createdAt DateTime @default(now())
}

model Conversation {
  id        String                  @id @default(cuid())
  userId    String
  title     String?
  status    String                  @default("ACTIVE")
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  isHidden  Boolean                 @default(false)
  user      User                    @relation(fields: [userId], references: [id])
  messages  Message[]
  summary    SessionSummaryV2?
  evaluation ConversationEvaluation?
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  role           String
  content        String
  meta           Json?
  agentId        String?          // 生成该消息的 Agent 名称 (P1)
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  feedback       MessageFeedback?
}

model MessageFeedback {
  id        String   @id @default(cuid())
  messageId String   @unique
  userId    String
  rating    Int
  reason    String?
  comment   String?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id])

  @@index([userId])
  @@index([rating])
}

model AssessmentReport {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  summary        String
  riskLevel      String
  mainIssue      String?
  createdAt      DateTime     @default(now())
  actionPlans    ActionPlan[]
  user           User         @relation(fields: [userId], references: [id])
}

model ActionPlan {
  id          String           @id @default(cuid())
  reportId    String
  title       String
  type        String
  content     Json
  isCompleted Boolean          @default(false)
  report      AssessmentReport @relation(fields: [reportId], references: [id])
  logs        ExerciseLog[]
}

model ExerciseLog {
  id           String      @id @default(cuid())
  userId       String
  actionPlanId String?
  type         String
  duration     Int
  preMood      Int?
  postMood     Int?
  feedback     String?
  completedAt  DateTime    @default(now())
  actionPlan   ActionPlan? @relation(fields: [actionPlanId], references: [id])
  user         User        @relation(fields: [userId], references: [id])
}


model MemoryCandidate {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  kind           String
  content        String
  confidence     Float
  evidence       Json?
  status         String   @default("pending") // pending | accepted | rejected | merged
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([conversationId])
  @@index([userId, kind])
}

model ProfileMemory {
  id                   String   @id @default(cuid())
  userId               String
  kind                 String
  fingerprint          String?
  content              String
  priority             Int      @default(50)
  confidence           Float
  sourceConversationId String?
  supersedes           String?
  lastConfirmedAt      DateTime?
  deletedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, priority])
  @@index([userId, deletedAt, updatedAt])
  @@index([sourceConversationId])
  @@index([userId, kind, fingerprint])
}

model MemoryExtractionLog {
  id             String   @id @default(cuid())
  conversationId String
  extractedCount Int
  status         String   // 'success' | 'failed' | 'skipped' | 'pending_retry'
  error          String?
  retryCount     Int      @default(0) // P3-C: 重试次数
  createdAt      DateTime @default(now())

  @@index([status, retryCount])
}


model SessionSummaryV2 {
  id             String   @id @default(cuid())
  userId         String
  conversationId String   @unique
  summary        String
  emotionLabel   String?
  emotionScore   Int?
  keyTopics      Json?
  actionItems    Json?
  createdAt      DateTime @default(now())

  // 从 V1 合并的 dashboard 字段（全部可空，兼容已有记录）
  mainTopic      String?
  startTime      DateTime?
  endTime        DateTime?
  duration       Int?
  emotionInitial Json?      // { label: "焦虑", score: 7 }
  moodChange     Int?       // emotionFinal.score - emotionInitial.score
  keyInsights    Json?      // ["洞察1", "洞察2"]
  therapistNote  String?

  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ConversationEvaluation {
  id             String   @id @default(cuid())
  conversationId String   @unique
  userId         String
  
  // 评估分数（0-10）
  legalScore        Int    // 法律合规性
  ethicalScore      Int    // 伦理规范
  professionalScore Int    // 专业性
  uxScore           Int    // 用户体验
  
  // 发现的问题（JSON 数组）
  legalIssues        Json   // string[]
  ethicalIssues      Json   // string[]
  professionalIssues Json   // string[]
  uxIssues           Json   // string[]
  
  // 整体评级
  overallGrade   String   // "A" | "B" | "C" | "D" | "F"
  overallScore   Float    // 综合得分（0-10）
  
  // 改进建议
  improvements   Json     // string[]
  
  // 元数据
  evaluatedBy    String   @default("deepseek")
  evaluatedAt    DateTime @default(now())
  
  // 审核状态: PENDING, ADOPTED, REJECTED
  reviewStatus   String   @default("PENDING")
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewNote     String?  // 驳回原因
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([overallGrade])
  @@index([evaluatedAt])
  @@index([overallScore])
}

model PromptOptimizationLog {
  id              String    @id @default(cuid())
  
  // 分析结果
  analyzedPeriod  String    // "2025-12-15 to 2025-12-22"
  lowScoreCount   Int
  commonIssues    Json
  suggestions     Json      // string[]
  affectedPrompts Json      // string[]
  
  // 元数据
  createdAt       DateTime  @default(now())
  appliedAt       DateTime?
  appliedBy       String?
  
  @@index([createdAt])
}

model OptimizationEvent {
  id             String   @id @default(cuid())
  conversationId String
  type           String   // 'LOW_SCORE', 'NEGATIVE_FEEDBACK', 'STUCK_LOOP'
  subType        String?  // For STUCK_LOOP: 'REPETITION', 'REFUSAL', 'PHASE_TIMEOUT'
  
  // 核心快照数据（避免联表查询）
  triggerMessageId String? // 触发事件的消息ID
  severity       Int      // 严重程度 (1-10)
  summary        String   // 事件摘要 (e.g. "用户点踩：觉得太啰嗦")
  details        Json?    // 额外详情（如分数、关键词等）
  
  // 状态流转
  status         String   @default("PENDING") // 'PENDING', 'PROCESSED', 'IGNORED'
  resolution     String?  // 解决变动 (e.g. "Updated prompt v2")
  processedAt    DateTime?
  processedBy    String?
  
  createdAt      DateTime @default(now())
  
  @@index([type, status])
  @@index([conversationId])
  @@index([createdAt])
}

model GoldenExample {
  id              String   @id @default(cuid())

  // 来源关联
  conversationId  String
  messageId       String   @unique  // 确保同一消息不会被多次纳入
  feedbackId      String?  // 关联的用户反馈ID

  // 对话内容快照（避免联表查询）
  userMessage     String   // 用户的问题/输入
  assistantMessage String  // AI 的优质回复
  context         String?  // 可选的上下文摘要

  // 状态
  status          String   @default("ACTIVE") // 'ACTIVE', 'ARCHIVED'

  // 元数据
  approvedBy      String   // 审批人 ID
  approvedAt      DateTime @default(now())
  userReason      String?  // 用户点赞原因
  adminNote       String?  // 管理员备注

  // 使用统计
  usageCount      Int      @default(0)  // 被注入的次数
  lastUsedAt      DateTime?

  @@index([status])
  @@index([approvedAt])
}

// 实验室会话记录
// 记录用户在实验室中的对话（智慧殿堂、镜像回廊、自定义大师、圆桌论道等）
model LabSession {
  id           String   @id @default(cuid())
  userId       String

  // 会话类型
  labType      String   // 'wisdom' | 'mirrors' | 'custom' | 'group'

  // 对话对象标识
  mentorId     String?  // 智慧殿堂: 大师ID (socrates, jung, adler, etc.)
  mbtiType     String?  // 镜像回廊: MBTI类型 (INTJ, ENFP, etc.)
  customName   String?  // 自定义大师: 自定义名称
  groupConfig  Json?    // 圆桌论道: {"mentorIds":["socrates","jung"],"mode":"discuss"|"debate"}

  // 会话元数据
  title        String?  // 会话标题（可由首条消息生成）
  messageCount Int      @default(0) // 消息数量

  // 时间戳
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 关联
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     LabMessage[]

  @@index([userId])
  @@index([userId, labType])
  @@index([createdAt])
}

// 实验室会话消息
model LabMessage {
  id           String     @id @default(cuid())
  sessionId    String
  role         String     // 'user' | 'assistant' | 'moderator' | 'synthesis'
  content      String
  mentorId     String?    // 群聊中标识哪位大师发言
  round        Int?       // 群聊中第几轮对话
  meta         Json?      // 元数据（mentorId、decision reason、phase metrics 等）
  createdAt    DateTime   @default(now())

  session      LabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// =============================================================================
// P0: 练习状态持久化
// =============================================================================

model ExerciseState {
  id            String   @id @default(cuid())
  userId        String
  exerciseType  String   // 'grounding' | 'reframing' | 'activation' | 'empty_chair' | 'breathing' | 'meditation'
  status        String   @default("pending") // 'pending' | 'in_progress' | 'completed' | 'abandoned'
  currentStep   Int      @default(0)
  totalSteps    Int      @default(1)
  metadata      Json?    // 练习特定的状态数据（如用户回答、中间结果）
  conversationId String?
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, exerciseType])
}

// =============================================================================
// P1: Agent 执行日志
// =============================================================================

model AgentLog {
  id             String   @id @default(cuid())
  conversationId String?
  agentName      String   // 'triage' | 'safety' | 'counselor' | 'quality'
  model          String   // 'groq' | 'deepseek'
  input          Json     // 输入摘要
  output         Json     // 输出摘要
  latency        Int      // 执行耗时 (ms)
  status         String   // 'success' | 'timeout' | 'error'
  error          String?
  createdAt      DateTime @default(now())

  @@index([agentName, status])
  @@index([conversationId])
  @@index([createdAt])
}

// =============================================================================
// P2: 危机升级通道
// =============================================================================

model CrisisEscalation {
  id              String    @id @default(cuid())
  userId          String
  conversationId  String
  triggerMessage   String    // 触发危机的消息内容
  riskLevel       String    // 'urgent' | 'crisis'
  safetyScore     Int       // 安全评分 (0-10)
  status          String    @default("PENDING") // 'PENDING' | 'ACKNOWLEDGED' | 'RESOLVED'
  escalatedTo     String?   // 通知的管理员
  resolution      String?   // 解决方案描述
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

// =============================================================================
// P5: 标准化问卷评估（PHQ-9 / GAD-7）
// =============================================================================

model QuestionnaireScore {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  type           String   // 'phq9' | 'gad7'
  responses      Json     // number[]
  score          Int
  severity       String   // 'minimal' | 'mild' | 'moderate' | 'moderately_severe' | 'severe'
  completedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, completedAt])
}

// =============================================================================
// P5: 纵向进度追踪
// =============================================================================

model ProgressMetric {
  id         String   @id @default(cuid())
  userId     String
  metricType String   // 'emotion' | 'phq9' | 'gad7' | 'session_mood_delta' | 'exercise_mood_delta'
  value      Float
  sessionId  String?
  note       String?
  recordedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, metricType, recordedAt])
}
